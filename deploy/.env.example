# cryptobot runtime environment (NO secrets in git; chmod 600 this file).
# Use demo keys first; never commit this file after filling it.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_DEMO_KEY=
BINANCE_DEMO_SECRET=
# Optional key files (must be 0600). Prefer env on systemd.
BINANCE_API_KEY_FILE=
BINANCE_API_SECRET_FILE=
# Arm acknowledgement is deliberately NOT stored here; the owner types it
# interactively at arm time.
CRYPTOBOT_CODE_COMMIT=
# Alert sinks (optional).
CRYPTOBOT_ALERT_WEBHOOK=
