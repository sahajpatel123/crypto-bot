[Unit]
Description=cryptobot research autopilot (idempotent run-once)
After=network-online.target cryptobot-recorder.service

[Service]
Type=oneshot
User=cryptobot
Group=cryptobot
WorkingDirectory=/opt/cryptobot
ExecStart=/opt/cryptobot/.venv/bin/cryptobot autopilot run-once
Nice=10
NoNewPrivileges=true
PrivateTmp=true
