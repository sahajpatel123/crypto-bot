# Copy the values into your shell environment — NEVER commit real keys,
# never paste them into chat, config files, or reports.
# Prefer `cryptobot keys set --profile demo|prod`, which stores these in the
# Keychain (macOS) or a git-ignored .env written mode 0600, and prints no
# value. This file is only a template: never commit a filled-in copy.
# Demo (Binance USD-M demo, free test funds):
CRYPTOBOT_DEMO_KEY=
CRYPTOBOT_DEMO_SECRET=
# Production (real money — only after the full LIVE_RUNBOOK gate passes):
CRYPTOBOT_API_KEY=
CRYPTOBOT_API_SECRET=
# Arming acknowledgement (exact phrase, required by `cryptobot arm`):
CRYPTOBOT_ARM_ACK=I UNDERSTAND LIVE CAPITAL IS AT RISK
